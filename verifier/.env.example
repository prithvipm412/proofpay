# ProofPay verifier settings (CLAUDE.md section 8).
# Copy this file to verifier/.env and fill in the values.
# Do not commit verifier/.env. Do not paste its content in chat or logs.

CHAIN_ID=
MONAD_RPC_URL=
ESCROW_ADDRESS=
START_BLOCK=
VERIFIER_PRIVATE_KEY=
# Vision model (OpenAI-compatible API).
# Gemini API free tier: VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#                   VISION_MODEL=gemma-4-26b-a4b-it (default; or gemini-3-flash-preview, RPD 20)
#                   VISION_REASONING_EFFORT=minimal
# Local Ollama fallback: VISION_BASE_URL=http://localhost:11434/v1, VISION_API_KEY=ollama (any non-empty text),
#                   VISION_REASONING_EFFORT empty (the parameter is then not sent).
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=
VISION_REASONING_EFFORT=
CORS_ORIGINS=
DATA_ROOT=
MIN_CONFIDENCE=
NEAR_HARD=
NEAR_WARN=
VERIFIER_MODE=
ADMISSION_MODE=
ALLOWLIST=
MAX_JOBS_PER_POSTER=
MAX_JOBS_PER_WORKER=
MAX_JOBS_PER_DAY=
MAX_MODEL_CALLS_PER_DAY=
MAX_VERDICT_TX_PER_DAY=
MAX_QUEUE=
MIN_SIGNER_BALANCE=
MAX_STORAGE_MB=
ADMISSION_UNTIL=
SAFE_HEAD_METHOD=
